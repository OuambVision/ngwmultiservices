{
  "name": "ngwmultiservices-api",
  "version": "0.1.0",
  "description": "ngwmultiservices Payload API and admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:catalog": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-catalog.ts",
    "seed:categories": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-category-descriptions.ts",
    "seed:category-images": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-category-images.ts",
    "seed:services": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-service-details.ts",
    "seed:availability": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-availability.ts",
    "seed:hero": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-hero.ts",
    "seed:realizations": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-realizations.ts",
    "seed:reviews": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed-reviews.ts",
    "seed:locales": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/enable-locales.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3000",
    "stripe-webhooks": "stripe listen --forward-to localhost:3000/api/stripe/webhooks",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.65.0",
    "@payloadcms/email-nodemailer": "3.65.0",
    "@payloadcms/next": "3.65.0",
    "@payloadcms/plugin-cloud-storage": "3.65.0",
    "@payloadcms/plugin-ecommerce": "3.65.0",
    "@payloadcms/plugin-form-builder": "3.65.0",
    "@payloadcms/plugin-seo": "3.65.0",
    "@payloadcms/richtext-lexical": "3.65.0",
    "@payloadcms/translations": "3.65.0",
    "@payloadcms/ui": "3.65.0",
    "@tanstack/react-query": "^5.90.11",
    "axios": "^1.13.2",
    "cloudinary": "^2.8.0",
    "cross-env": "^7.0.3",
    "dotenv": "^8.2.0",
    "graphql": "^16.8.2",
    "jsonwebtoken": "9.0.1",
    "next": "^15.5.7",
    "next-auth": "^4.24.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "payload": "3.65.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.38.0",
    "sharp": "0.34.2",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@next/eslint-plugin-next": "^15.5.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.0.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "22.15.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.1.0",
    "exceljs": "^4.4.0",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.12",
    "typescript": "5.7.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  }
}
